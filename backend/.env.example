# Copy this file to .env and fill in real values. .env is gitignored.

# --- Django core ---
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Chatbot LLM Configuration ---
# Option A (default): local Ollama — free, fully private, requires you to run
# `ollama serve` and `ollama pull llama3.2` (or another local model) yourself.
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_API_KEY=

# Option B (recommended default): Groq cloud — free tier, fast, strong tool
# calling. Get a free API key at https://console.groq.com/keys, then set:
# OLLAMA_API_URL=https://api.groq.com/openai/v1
# OLLAMA_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=<your groq api key>
#
# Other OpenAI-compatible endpoints (Gemini, Together AI, OpenAI itself, etc.)
# also work — the app detects "groq"/"together"/"openai" in OLLAMA_API_URL, or
# the presence of LLM_API_KEY, to switch to cloud mode.

# --- Optional fallback provider ---
# Groq's free tier has fairly tight per-minute AND per-day token caps. If the
# primary provider above fails for any reason (rate limit, daily quota,
# connection issue), the chatbot automatically retries the same request
# against this fallback provider instead of failing outright. Leave
# FALLBACK_LLM_API_URL empty to disable this behavior.
#
# Example using Gemini (get a free key at https://aistudio.google.com/apikey —
# Gemini's free tier has much higher token-per-minute headroom than Groq's):
# FALLBACK_LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
# FALLBACK_LLM_MODEL=gemini-3.5-flash-lite
# FALLBACK_LLM_API_KEY=<your gemini api key>
